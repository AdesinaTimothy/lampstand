    "dotenv-cli": "^10",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.7",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
