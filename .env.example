# ── Core ─────────────────────────────────────────────────────────────
# Public base URL of the app (used in emails, certificates, CSRF origin checks)
APP_URL="http://localhost:3000"
# Slug of the organization this deployment serves (created by the seed)
APP_ORGANIZATION_SLUG="grace-harbor"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lampstand?schema=public"
# 32+ random bytes; used to hash IPs for certificate verification logs.
# Generate with: openssl rand -base64 32
APP_SECRET="change-me-to-a-long-random-string"

# ── Storage ──────────────────────────────────────────────────────────
# "local" stores files under STORAGE_LOCAL_DIR; "s3" uses any S3-compatible service
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Email ────────────────────────────────────────────────────────────
# "log" records emails in the outbox and prints them (development);
# "smtp" delivers through SMTP_URL
MAIL_DRIVER="log"
MAIL_FROM="Lampstand <no-reply@example.org>"
SMTP_URL=""               # e.g. smtp://user:pass@smtp.postmarkapp.com:587
